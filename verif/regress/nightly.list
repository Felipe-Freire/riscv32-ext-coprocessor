# Nightly regression: the random tests with new seeds on every run (the table shows them).
# Run it with `make regress LIST=verif/regress/nightly.list JOBS=4`.

UVM=core_pc TEST=core_pc_stress_test SEED=random
UVM=core_pc TEST=core_pc_stress_test SEED=random
UVM=core_pc TEST=core_pc_stress_test SEED=random

UVM=coproc TEST=coproc_matmul_rand_test SEED=random PLUSARGS=+JOBS=100
UVM=coproc TEST=coproc_matmul_rand_test SEED=random PLUSARGS=+JOBS=100
UVM=coproc TEST=coproc_matmul_rand_test SEED=random PLUSARGS=+JOBS=100
UVM=coproc TEST=coproc_cdc_test SEED=random
UVM=coproc TEST=coproc_cdc_test SEED=random
UVM=coproc TEST=coproc_cdc_test SEED=random
UVM=coproc TEST=coproc_reset_test SEED=random
UVM=coproc TEST=coproc_reset_test SEED=random
UVM=coproc TEST=coproc_reset_test SEED=random
UVM=coproc TEST=coproc_matmul_directed_test PLUSARGS=+BIG_K

# Data bus crossbar: random traffic from both masters
TB=tb_bus_axi_xbar SEED=random PLUSARGS=+TXNS=5000
TB=tb_bus_axi_xbar SEED=random PLUSARGS=+TXNS=5000
TB=tb_bus_axi_xbar SEED=random PLUSARGS=+TXNS=5000

# Core bridge: random loads and stores against random stalls
TB=tb_bus_obi2axi SEED=random PLUSARGS=+OPS=20000
TB=tb_bus_obi2axi SEED=random PLUSARGS=+OPS=20000
TB=tb_bus_obi2axi SEED=random PLUSARGS=+OPS=20000

# Interconnect: random core accesses over the whole memory map, beside random DMA bursts
TB=tb_bus_top SEED=random PLUSARGS=+OPS=20000
TB=tb_bus_top SEED=random PLUSARGS=+OPS=20000
TB=tb_bus_top SEED=random PLUSARGS=+OPS=20000

# SoC integration: random matrix sizes through bus_top, the DMA and the coprocessor
TB=tb_bus_dma_coproc SEED=random PLUSARGS=+RAND=8
TB=tb_bus_dma_coproc SEED=random PLUSARGS=+RAND=8
TB=tb_bus_dma_coproc SEED=random PLUSARGS=+RAND=8

# Memories on the OpenRAM macros: random accesses with new seeds
TB=tb_prim_ram_1p SEED=random MEM_TECH=openram45 PLUSARGS=+OPS=100000
TB=tb_mem_tcm SEED=random MEM_TECH=openram45 PLUSARGS=+OPS=100000
TB=tb_mem_l2_bank SEED=random MEM_TECH=openram45 PLUSARGS=+TXNS=10000
